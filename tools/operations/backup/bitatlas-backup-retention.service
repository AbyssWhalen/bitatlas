[Unit]
Description=BitAtlas approved backup retention

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/bitatlas-backup/bin/retention.py --apply
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/bitatlas-backup/snapshots /srv/bitatlas-backup/operations
